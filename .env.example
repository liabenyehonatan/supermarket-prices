# ── Required ──────────────────────────────────────────────────────────────────
# Owner password for PostgreSQL (schema changes + the ingestion worker).
POSTGRES_PASSWORD=change-me-in-production
# Password of the read-only role the public API connects with. Different from the above.
API_DB_PASSWORD=change-me-too

# ── Local development (without docker compose) ────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://supermarket:change-me-in-production@localhost:5432/supermarket_prices

# ── Optional ──────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API cross-origin (comma-separated). Not
# needed when everything is served through the bundled nginx (same origin).
FRONTEND_URL=
# API base URL baked into the frontend build. Leave empty behind nginx.
VITE_API_URL=

# Healthchecks.io-style URLs: the worker pings /start, success, /fail.
HEALTHCHECK_URL=
HEALTHCHECK_BACKUP_URL=

# Ingestion worker
SKIP_BLOCKED_CHAINS=false     # keep false on an Israeli server; true skips the 12 Israel-only chains
DELTA_EVERY_HOURS=3
SCRAPE_CONCURRENCY=3
PARSE_CONCURRENCY=2
MIN_FREE_DISK_GB=5
HISTORY_RETENTION_DAYS=       # empty = keep every price row (project default)

# Database sizing hints for the host (defaults suit a 4 GB machine)
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE_SIZE=2GB
# API_WORKERS=2

# Backups
BACKUP_KEEP_DAYS=7
BACKUP_HOUR_UTC=0

# Download promotion files. Nothing parses them yet, so leave off.
SCRAPE_PROMOS=false
