# HTTPS front door. Caddy gets and renews a free certificate for $DOMAIN by itself
# (Let's Encrypt) and hands plain requests to the nginx container.
# Needs: DNS for $DOMAIN pointing at this server, and ports 80 and 443 open to the internet.
{$DOMAIN} {
	encode gzip

	# Tell browsers to use https for this site from now on (six months; raise it once everything works).
	header Strict-Transport-Security "max-age=15552000"

	reverse_proxy nginx:80
}

# Send the "www." spelling to the main address. Uncomment once DNS has a record for www.<domain>
# (a certificate for a name that does not resolve cannot be issued).
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
